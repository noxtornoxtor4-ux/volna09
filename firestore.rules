rules_version = '2';

// Правила доступа к базе «Волны». Вставьте их в Firebase Console →
// Firestore Database → Rules и нажмите Publish.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    // Публичные профили: видят все вошедшие, меняет только сам пользователь
    match /people/{uid} {
      allow read: if signedIn();
      allow write: if signedIn() && request.auth.uid == uid;
    }

    // Организации: страницу правят кураторы; новый куратор может только добавить себя
    match /orgs/{orgId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.auth.uid in request.resource.data.ownerIds;
      allow update: if signedIn() && (
        request.auth.uid in resource.data.ownerIds ||
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ownerIds']) &&
          request.resource.data.ownerIds.hasAll(resource.data.ownerIds)
        )
      );
      allow delete: if signedIn() && request.auth.uid in resource.data.ownerIds;
    }

    // Файлы (видео, оригиналы сертификатов) хранятся частями до 1 МБ
    match /files/{fileId} {
      allow read, write: if signedIn();
      match /parts/{part} {
        allow read, write: if signedIn();
      }
    }

    // Мероприятия, заявки, посты, чаты, уведомления и остальное — для вошедших пользователей
    match /{collection}/{id} {
      allow read, write: if signedIn() && collection in [
        'topics', 'opportunities', 'applications', 'hours', 'posts', 'awards',
        'skills', 'skillMaterials', 'threads', 'conversations', 'announcements',
        'alerts', 'dayPhotos'
      ];
    }
  }
}
